
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FITNESS PRO GYM</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>FITNESS<span>PRO</span></h1>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#plans">Plans</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero" id="home">
    <div class="hero-content">
        <h2>BUILD YOUR<br><span>PERFECT BODY</span></h2>
        <p>Push Your Limits. Transform Your Life.</p>
        <a href="#plans" class="btn">JOIN OUR GYM</a>
    </div>
</section>

<section id="about">
    <h2>ABOUT OUR GYM</h2>
    <p>
        Welcome to Fitness Pro Gym.
        We help you build strength, confidence
        and a healthy lifestyle.
    </p>
</section>

<section id="services">
    <h2>OUR SERVICES</h2>

    <div class="cards">
        <div class="card">
            <h3>💪 Weight Training</h3>
            <p>Build strength and muscle.</p>
        </div>

        <div class="card">
            <h3>🏃 Cardio Training</h3>
            <p>Improve stamina and fitness.</p>
        </div>

        <div class="card">
            <h3>🏋 Personal Training</h3>
            <p>Professional fitness guidance.</p>
        </div>
    </div>
</section>

<section id="plans">
    <h2>MEMBERSHIP PLANS</h2>

    <div class="cards">
        <div class="card">
            <h3>Monthly</h3>
            <h2>₹999</h2>
            <p>1 Month Membership</p>
            <button onclick="joinGym('Monthly Plan')">
                Join Now
            </button>
        </div>

        <div class="card featured">
            <h3>Quarterly</h3>
            <h2>₹2499</h2>
            <p>3 Months Membership</p>
            <button onclick="joinGym('Quarterly Plan')">
                Join Now
            </button>
        </div>

        <div class="card">
            <h3>Yearly</h3>
            <h2>₹7999</h2>
            <p>12 Months Membership</p>
            <button onclick="joinGym('Yearly Plan')">
                Join Now
            </button>
        </div>
    </div>
</section>

<section id="contact">
    <h2>CONTACT US</h2>

    <form id="contactForm">
        <input type="text" id="name"
            placeholder="Your Name" required>

        <input type="tel" id="phone"
            placeholder="Mobile Number" required>

        <textarea id="message"
            placeholder="Your Message"></textarea>

        <button type="submit">SEND MESSAGE</button>
    </form>
</section>

<footer>
    <h2>FITNESS PRO GYM</h2>
    <p>Train Hard. Stay Strong. Live Healthy.</p>
    <p>© 2026 Fitness Pro Gym</p>
</footer>

<script src="script.js"></script>

</body>
</html>
